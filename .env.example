# Copy to .env for `make run`. Every APP_* setting is documented in src/fastapi_service_template/config.py.
APP_ENVIRONMENT=local
APP_LOG_JSON=false
APP_LOG_LEVEL=DEBUG
APP_DATABASE_URL=postgresql+asyncpg://app:app@localhost:5432/app

# Standard OpenTelemetry variables. Remove the endpoint to stop exporting traces.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
